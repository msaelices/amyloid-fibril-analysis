# Jupyter
.ipynb_checkpoints/

# Data & models -- never commit patient data or large binaries.
# Ignore data/ wholesale: listing subfolders individually meant any new one
# (e.g. a derived dataset) silently defaulted to being tracked.
data/**
models/**
*.mrc
*.tif
*.tiff
*.pptx
!**/.gitkeep
!data/**/README.md

# OS
.DS_Store
Thumbs.db

# Outputs
outputs/
outputs_demo/
*.log
