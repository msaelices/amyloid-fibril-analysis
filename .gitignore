# Jupyter
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# PATIENT DATA -- must never leave this machine.
#
# Deny by default. Whole directories are ignored and the handful of tracked
# placeholders are re-included explicitly, so anything new dropped inside them
# is ignored without anyone having to remember to add a rule. The extension
# rules below are the safety net for files dropped outside those directories,
# which is how a 58 MB deck of micrographs once ended up in the repo root.
#
# To commit something these rules catch (a documentation figure, say), be
# explicit about it: git add -f docs/img/pipeline.png
# ---------------------------------------------------------------------------
data/**
models/**
outputs/
outputs_demo/

# Re-include the directory scaffolding: git will not descend into an excluded
# directory, so without these the placeholder rules below can never match.
!data/**/
!models/**/
!**/.gitkeep
!data/**/README.md

